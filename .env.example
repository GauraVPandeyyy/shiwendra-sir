# Set the canonical HTTPS domain before the production build.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional Google Search Console verification token (meta verification).
GOOGLE_SITE_VERIFICATION=
# Exact comma-separated form origins; HTTPS in production.
CONTACT_ALLOWED_ORIGINS=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
CONTACT_RECIPIENT=
# Configure only a header overwritten by YOUR trusted hosting proxy.
CONTACT_TRUSTED_IP_HEADER=
# Optional shared abuse-rate counters (Upstash-compatible REST); no submissions stored.
RATE_LIMIT_REST_URL=
RATE_LIMIT_REST_TOKEN=
# Optional authorized social API adapter emitting the documented normalized JSON array.
SOCIAL_FEED_URL=
SOCIAL_FEED_TOKEN=
# Official social profiles. Defaults are already configured in src/content/site.ts; override only if needed.
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/shiwendra4rbl/
NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@Shiwendrashukla4rbl
# Optional: a real public YouTube video ID to feature in the Home social dashboard.
NEXT_PUBLIC_YOUTUBE_FEATURED_VIDEO_ID=
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_PUBLIC_EMAIL=
NEXT_TELEMETRY_DISABLED=1
